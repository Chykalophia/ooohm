# Required
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL people use to reach OOOhm (used in sign-in links)
BETTER_AUTH_URL=http://localhost:3000

# First admin, created on first start. Sign in with this email.
SEED_ADMIN_EMAIL=you@company.com
SEED_ADMIN_NAME=
SEED_COMPANY_NAME=My Company

# Database
# docker compose sets DATABASE_URL for the app automatically.
# Only needed when running outside Docker (pnpm dev). If you change POSTGRES_PASSWORD
# or DB_PORT below, update the password and port in this URL to match.
DATABASE_URL=postgres://ooohm:ooohm@localhost:5432/ooohm
# URL-safe characters only (letters, digits, - _ . ~); it's embedded in DATABASE_URL.
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=ooohm
# Host port for Postgres when 5432 is taken (docker compose publishes it on 127.0.0.1).
DB_PORT=5432
# Optional: a direct (unpooled) URL for migrations when DATABASE_URL goes through a pooler
# (Neon's -pooler host, Supabase on port 6543). Migrations use it when set.
DATABASE_URL_UNPOOLED=
# Optional: "transaction" if DATABASE_URL is a transaction pooler OOOhm cannot recognise
# (e.g. your own PgBouncer), which turns prepared statements off; "session" or "none"
# to say it is not. Neon -pooler hosts and Supabase's port 6543 are detected.
DATABASE_POOLER=
# Optional: connections per process (default 10; 3 when VERCEL or DATABASE_SERVERLESS=true).
DATABASE_POOL_MAX=
DATABASE_SERVERLESS=

# --- Embedded database (no Postgres server) ------------------------------------
# OOOHM_DB=embedded runs on PGlite, Postgres in-process, storing data in OOOHM_DATA_DIR.
# One process only: `pnpm build` once, then `pnpm start:embedded` (it sets OOOHM_DB itself).
# See docs/hosting.md.
OOOHM_DB=
OOOHM_DATA_DIR=./data/pglite

# --- Background work -------------------------------------------------------------
# worker: a `pnpm worker` process delivers webhooks and runs the daily jobs (the default,
#         and what docker compose sets). inline: the app does it right after each change
#         (the default on Vercel and in embedded mode). cron: only /api/cron/tick does it.
OOOHM_BACKGROUND=
# How long one tick may start new work, in milliseconds (default 15000).
OOOHM_TICK_BUDGET_MS=
# Embedded mode: seconds between the app's own ticks (retries, daily jobs). Default 30.
OOOHM_TICK_INTERVAL_SECONDS=
# Authorizes GET /api/cron/tick (Authorization: Bearer <secret>). Unset = the route refuses
# every call. At least 32 characters: openssl rand -hex 32
CRON_SECRET=

# Email (sign-in links + notifications)
# Leave SMTP_HOST empty to use Mailpit from docker compose (view mail at http://localhost:8025).
# With `pnpm dev` an empty value means localhost:1025.
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
# Mailpit has no TLS. With a real provider on port 587, set this to true (the production default).
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=OOOhm <no-reply@ooohm.team>

# Reverse proxy
# How many proxies in front of OOOhm append the client's address to X-Forwarded-For
# (nginx: proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; Caddy and
# Traefik do it by default). 0 = no trusted proxy: calendar-feed rate limits then use one
# shared bucket, because a client can write X-Forwarded-For itself. Never set it higher
# than the real number of proxies, or clients can choose their own rate-limit key.
TRUSTED_PROXY_HOPS=0

# Integrations (webhooks, REST API)
# Required. Encrypts webhook signing secrets at rest (AES-256-GCM). The app and the
# worker need the same value. Generate with: openssl rand -base64 32
# Changing it makes every existing endpoint's secret unreadable: rotate each one after.
WEBHOOK_ENCRYPTION_KEY=
# Local development only: allow http:// webhook URLs, and URLs on loopback/private
# addresses (e.g. a receiver on your own machine). Keep both false in production.
WEBHOOK_ALLOW_INSECURE=false
WEBHOOK_ALLOW_PRIVATE=false
# debug, info, warn or error (app and worker).
LOG_LEVEL=info
# Worker only: how often an idle worker looks for work, backing off up to the maximum.
WORKER_POLL_INTERVAL_MS=1000
WORKER_MAX_IDLE_MS=10000

# Optional: Google sign-in
# Redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
