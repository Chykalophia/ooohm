# OOOhm production settings for deploy/docker-compose.prod.yml.
#
#   cp .env.production.example .env.production && chmod 600 .env.production
#   docker compose --env-file .env.production -f deploy/docker-compose.prod.yml up -d --build
#
# Every value marked REQUIRED must be set; compose stops with the variable's name if one
# is missing. Generate secrets on the server and never commit the filled-in file
# (.gitignore and .dockerignore already exclude it). See docs/deploy.md.

# --- Domain and TLS --------------------------------------------------------------
# REQUIRED. The public host name. Its DNS A/AAAA records must point at this server
# before the first start, or Let's Encrypt cannot issue the certificate.
OOOHM_DOMAIN=ooohm.team
# REQUIRED. Let's Encrypt sends certificate expiry notices here.
ACME_EMAIL=you@example.com
# Host ports Caddy publishes. Keep 80 and 443 in production (ACME needs them).
HTTP_PORT=80
HTTPS_PORT=443

# --- Auth --------------------------------------------------------------------------
# REQUIRED. The public URL, used in sign-in links. https and no trailing slash.
BETTER_AUTH_URL=https://ooohm.team
# REQUIRED. Signs sessions. Generate: openssl rand -base64 32
# Changing it signs everyone out.
BETTER_AUTH_SECRET=

# Optional Google sign-in (it still only lets in people who already have an account).
# Authorized redirect URI in Google Cloud: https://ooohm.team/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- First admin (created on first start, idempotent afterwards) -------------------
# REQUIRED. Sign in with this address the first time.
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_NAME=
SEED_COMPANY_NAME=Chykalophia

# --- Database ----------------------------------------------------------------------
# REQUIRED. URL-safe characters only. Generate: openssl rand -hex 24
# The compose file builds DATABASE_URL from it (postgres://ooohm:<password>@db:5432/ooohm)
# for the app, the worker and migrations, so DATABASE_URL is not set here.
# Set it before the first start: Postgres keeps the first password in its volume, and
# changing it here later does not change it there (see docs/deploy.md).
POSTGRES_PASSWORD=

# --- Email (sign-in links and notifications) ------------------------------------------
# REQUIRED. A transactional provider's SMTP relay. Examples:
#   Postmark   SMTP_HOST=smtp.postmarkapp.com, SMTP_PORT=587, SMTP_USER and SMTP_PASSWORD = the server API token
#   Amazon SES SMTP_HOST=email-smtp.<region>.amazonaws.com, SMTP_PORT=587, SMTP_USER/SMTP_PASSWORD = SES SMTP credentials
#   Mailgun    SMTP_HOST=smtp.mailgun.org, SMTP_PORT=587, SMTP_USER=postmaster@<your sending domain>, SMTP_PASSWORD = its SMTP password
# Port 587 uses STARTTLS (SMTP_SECURE=false); port 465 uses TLS from the start (SMTP_SECURE=true).
# Hetzner blocks outgoing ports 25 and 465 on new accounts; 587 works. The sending
# domain needs SPF, DKIM and DMARC records (docs/deploy.md).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# With SMTP_SECURE=false, refuse to send unless STARTTLS succeeds, so a network attacker
# who strips STARTTLS cannot read the SMTP password or sign-in links. Keep it true.
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
# REQUIRED. A sender address your provider has verified.
MAIL_FROM=OOOhm <no-reply@ooohm.team>

# --- Integrations --------------------------------------------------------------------
# REQUIRED. Encrypts webhook signing secrets at rest; the app and the worker share it.
# Generate: openssl rand -base64 32
# Changing it makes every webhook endpoint's secret unreadable (rotate each one after).
WEBHOOK_ENCRYPTION_KEY=

# Background work: the compose file sets OOOHM_BACKGROUND=worker for the app, and the
# `worker` service delivers webhooks and runs the daily jobs, so there is nothing to set
# here. GET /api/cron/tick stays shut while CRON_SECRET is unset, which is right for this
# setup. (Vercel and other hosts: docs/hosting.md.)

# --- Operations ----------------------------------------------------------------------
# debug, info, warn or error (app and worker).
LOG_LEVEL=info
