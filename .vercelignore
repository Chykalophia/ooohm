# What `vercel deploy` from a local checkout must not upload. The CLI does not read
# .gitignore, so without this file it sends local env files and tool folders along with
# the source, and the build picks up a local .env (dev-only switches such as
# WEBHOOK_ALLOW_PRIVATE=true). Production settings live in Vercel's environment variables.

# Local env files (the committed examples stay).
.env
.env.*
!.env.example
!.env.production.example

# Local tools and state.
.claude
.audit-baseline.json
audit.config.yaml
data
coverage
*.sqlite
*.tsbuildinfo
.DS_Store
