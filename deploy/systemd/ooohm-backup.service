# Nightly OOOhm database backup. Install with the timer (docs/deploy.md, "Backups"):
#   sudo cp deploy/systemd/ooohm-backup.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now ooohm-backup.timer
[Unit]
Description=OOOhm database backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/srv/ooohm
Environment=BACKUP_DIR=/var/backups/ooohm
Environment=RETENTION_DAYS=30
# Optional off-site copy: a command that gets the new backup's path as its only argument
# (docs/deploy.md, "Off-site copies", has a Hetzner Storage Box example).
# Environment=OFFSITE_HOOK=/usr/local/bin/ooohm-offsite
ExecStart=/srv/ooohm/deploy/backup.sh
