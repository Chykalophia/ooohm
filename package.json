{
  "name": "ooohm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.mts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.mts",
    "job:rollover": "tsx --conditions=react-server --env-file-if-exists=.env scripts/rollover.mts",
    "import:timeoff": "tsx --conditions=react-server --no-warnings=ExperimentalWarning --env-file-if-exists=.env scripts/import-timeoff.mts",
    "worker": "tsx --conditions=react-server --env-file-if-exists=.env scripts/worker.mts",
    "test": "tsx --conditions=react-server --no-warnings=ExperimentalWarning --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "tsx --conditions=react-server --no-warnings=ExperimentalWarning --test \"tests/integration/**/*.test.ts\""
  },
  "dependencies": {
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "nodemailer": "^10.3.1",
    "postgres": "^4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.28.0",
  "license": "SEE LICENSE IN LICENSE.md"
}
