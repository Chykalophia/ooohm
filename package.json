{
  "name": "ooohm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:check-drift": "tsx --conditions=react-server scripts/check-drift.mts",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env scripts/migrate.mts",
    "db:roles": "tsx --conditions=react-server --env-file-if-exists=.env scripts/db-roles.mts",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env scripts/seed.mts",
    "job:rollover": "tsx --conditions=react-server --env-file-if-exists=.env scripts/rollover.mts",
    "import:timeoff": "tsx --conditions=react-server --no-warnings=ExperimentalWarning --env-file-if-exists=.env scripts/import-timeoff.mts",
    "worker": "tsx --conditions=react-server --env-file-if-exists=.env scripts/worker.mts",
    "test": "tsx --conditions=react-server --no-warnings=ExperimentalWarning --test \"tests/unit/**/*.test.ts\" \"tests/architecture/**/*.test.ts\" \"tests/contracts/**/*.test.ts\"",
    "test:components": "tsx --no-warnings=ExperimentalWarning --experimental-test-module-mocks --import ./tests/components/setup.ts --test \"tests/components/**/*.test.tsx\"",
    "test:integration":"tsx --conditions=react-server --no-warnings=ExperimentalWarning --test \"tests/integration/**/*.test.ts\"",
    "test:integration:embedded": "TEST_DATABASE_URL=pglite:memory tsx --conditions=react-server --no-warnings=ExperimentalWarning --test \"tests/integration/**/*.test.ts\"",
    "test:e2e": "tsx --conditions=react-server --no-warnings=ExperimentalWarning --test --test-concurrency=1 --test-reporter=spec \"tests/e2e/**/*.spec.ts\"",
    "start:embedded": "OOOHM_DB=embedded pnpm db:migrate && OOOHM_DB=embedded pnpm db:seed && OOOHM_DB=embedded next start",
    "vercel-build": "tsx --conditions=react-server scripts/migrate.mts --if-production && tsx --conditions=react-server scripts/seed.mts --if-production && next build",
    "arch": "depcruise src --config .dependency-cruiser.cjs --output-type err",
    "madge": "madge --circular --extensions ts,tsx --ts-config tsconfig.json src"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.15",
    "@electric-sql/pglite": "^0.5.14",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "nodemailer": "^10.3.1",
    "postgres": "^4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "^16.10.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "global-jsdom": "30.0.0",
    "jsdom": "30.1.3",
    "madge": "^8.0.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.28.0",
  "license": "SEE LICENSE IN LICENSE.md"
}
